# Copy file này thành .env trên máy local. Không commit .env.
# Không đặt AWS access key/secret key trong repo; dùng aws configure hoặc IAM role.
AWS_PROFILE=your-aws-profile
AWS_REGION=us-east-1
BEDROCK_KB_ID=your-bedrock-knowledge-base-id
BEDROCK_DATA_SOURCE_ID=your-bedrock-data-source-id
BEDROCK_MODEL_ID=your-bedrock-model-id
S3_KB_BUCKET=your-s3-knowledge-base-bucket
